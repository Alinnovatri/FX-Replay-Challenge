{
  "name": "fx-replay-challenge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.8.1+sha512.c50088ba998c67b8ca8c99df8a5e02fd2ae2e2b29aaf238feaa9e124248d3f48f9fb6db2424949ff901cffbb5e0f0cc1ad6aedb602cd29450751d11c35023677",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "DB_DRIVER=pglite PGLITE_DIR=.pglite node scripts/migrate.mjs && DB_DRIVER=pglite PGLITE_DIR=.pglite next dev",
    "build": "DB_DRIVER=pglite PGLITE_DIR=memory:// next build",
    "start": "next start",
    "vercel-build": "node scripts/vercel-build.mjs",
    "lint": "eslint . --max-warnings=0 && prettier --check . && markdownlint-cli2",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "lhci": "DB_DRIVER=pglite PGLITE_DIR=memory:// lhci autorun",
    "smoke": "node scripts/smoke.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "check:config": "node scripts/validate-claude-config.mjs && node scripts/brand/generate-tokens.mjs --check && node scripts/brand/contrast.mjs --check && node --test scripts/brand/brand.test.mjs scripts/validate-claude-config.test.mjs scripts/vercel-build.test.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@neondatabase/serverless": "1.2.0",
    "drizzle-orm": "0.45.4",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.2",
    "markdownlint-cli2": "0.23.3",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  }
}
