{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": [
    "playwright"
  ],
  "permissions": {
    "allow": [
      "Bash(node scripts/brand/generate-tokens.mjs:*)",
      "Bash(node scripts/brand/contrast.mjs:*)",
      "Bash(node scripts/validate-claude-config.mjs:*)",
      "Bash(node --test:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "mcp__playwright__browser_navigate",
      "mcp__playwright__browser_snapshot",
      "mcp__playwright__browser_take_screenshot",
      "mcp__playwright__browser_evaluate",
      "mcp__playwright__browser_resize",
      "mcp__c338174a-e0b4-4e64-9fd3-9cd7c56b0020__list_projects",
      "mcp__c338174a-e0b4-4e64-9fd3-9cd7c56b0020__get_project",
      "mcp__c338174a-e0b4-4e64-9fd3-9cd7c56b0020__list_deployments",
      "mcp__c338174a-e0b4-4e64-9fd3-9cd7c56b0020__get_deployment",
      "mcp__c338174a-e0b4-4e64-9fd3-9cd7c56b0020__list_deployment_events",
      "mcp__c338174a-e0b4-4e64-9fd3-9cd7c56b0020__get_runtime_errors",
      "mcp__c338174a-e0b4-4e64-9fd3-9cd7c56b0020__get_runtime_logs"
    ],
    "ask": [
      "mcp__41e0c87a-ded5-49f9-a886-d474d85842e3__exec"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)",
      "Read(./.env.development)",
      "Read(./private/**)",
      "Read(./.envrc)",
      "Read(./.env.test)",
      "Read(./.env.staging)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Read(./**/.envrc)",
      "Read(./**/.env.production)",
      "Read(./**/.env.development)",
      "Read(./**/.env.test)",
      "Read(./**/.env.staging)",
      "Read(./**/.env-*)",
      "Bash(gh pr merge:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push --force:*)",
      "Bash(vercel env:*)",
      "Bash(vercel promote:*)",
      "Bash(vercel rollback:*)",
      "Bash(vercel deploy --prod:*)",
      "Bash(vercel --prod:*)",
      "Bash(neonctl connection-string:*)",
      "Bash(drizzle-kit push:*)",
      "Bash(pnpm drizzle-kit push:*)",
      "Bash(git push -f:*)",
      "Bash(git push -u origin main:*)",
      "Bash(git push origin HEAD:refs/heads/main:*)",
      "Bash(git push origin +main:*)",
      "Bash(npx drizzle-kit push:*)",
      "Bash(pnpm exec drizzle-kit push:*)",
      "Bash(vercel deploy --yes --prod:*)",
      "Bash(vercel --yes --prod:*)",
      "mcp__c338174a-e0b4-4e64-9fd3-9cd7c56b0020__create_project_env",
      "mcp__c338174a-e0b4-4e64-9fd3-9cd7c56b0020__edit_project_env",
      "mcp__c338174a-e0b4-4e64-9fd3-9cd7c56b0020__get_project_env",
      "mcp__c338174a-e0b4-4e64-9fd3-9cd7c56b0020__filter_project_envs",
      "mcp__c338174a-e0b4-4e64-9fd3-9cd7c56b0020__get_shared_env_var",
      "mcp__c338174a-e0b4-4e64-9fd3-9cd7c56b0020__request_promote",
      "mcp__c338174a-e0b4-4e64-9fd3-9cd7c56b0020__request_rollback",
      "mcp__c338174a-e0b4-4e64-9fd3-9cd7c56b0020__start_rolling_release",
      "mcp__c338174a-e0b4-4e64-9fd3-9cd7c56b0020__approve_rolling_release_stage",
      "mcp__c338174a-e0b4-4e64-9fd3-9cd7c56b0020__complete_rolling_release",
      "mcp__c338174a-e0b4-4e64-9fd3-9cd7c56b0020__update_project_protection_bypass"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Bash|Grep|Glob|mcp__playwright__browser_navigate",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/env-guard.mjs\""
          }
        ]
      }
    ]
  }
}
