# Copy to .env.local only if you need to override the package scripts; the scripts already set these for
# local development and tests. Never commit real values.

# Local and test database driver: "pglite" (embedded Postgres). On Vercel the driver is always Neon.
DB_DRIVER=pglite
# PGlite data directory: a folder path for dev, or memory:// for tests.
PGLITE_DIR=.pglite

# Production only. Set by the Neon integration from the Vercel Marketplace; never paste it by hand.
# DATABASE_URL=
